# Copy to .env (never commit .env). All variables are optional.

# Where the API looks for model bundles and pre-computed reports.
FAIRPATH_ARTIFACTS=artifacts
FAIRPATH_REPORTS=reports
# Built dashboard to serve from "/" (leave unset to serve the API only).
FAIRPATH_WEB_DIR=web/out
# Comma-separated list of origins allowed to call the API from a browser.
FAIRPATH_CORS_ORIGINS=*
FAIRPATH_LOG_LEVEL=INFO

# Dashboard build-time settings (only needed if the dashboard and API are hosted separately).
NEXT_PUBLIC_API_BASE=
NEXT_PUBLIC_REPO_URL=https://github.com/your-username/fairpath
